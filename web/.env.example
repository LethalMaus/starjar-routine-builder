# Optional cloud configuration. Without it, local AI and all manual features work.
# Use a separately registered Firebase WEB app, never the Android app ID.
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_API_KEY=
VITE_RECAPTCHA_SITE_KEY=
# Never put an App Check debug token or service-account key here: VITE_* is bundled.
